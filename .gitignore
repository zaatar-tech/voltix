# Build output
dist/
site/dist-ssr/
*.log

# Benchmark build files
benchmark/dist/
benchmark/node_modules/

# Node modules
node_modules/

# Lockfiles from other package managers (package-lock.json is committed — CI runs `npm ci`)
yarn.lock
pnpm-lock.yaml

# IDE / local tooling state — never belongs in the repo
.vscode/
.idea/
.claude/
.codex/
.wrangler/
*.tgz

# Local environment, credentials, and private keys
.env
.env.*
!.env.example
!.env.*.example
.npmrc
.netrc
.aws/
.ssh/
*.pem
*.key
*.p12
*.pfx

# Generated at prebuild by site/scripts/prepare.mjs (og.png is NOT — keep it committed)
site/public/docs/
site/public/llms.txt
site/public/sitemap.xml

google*.html
site/public/_redirects

# MacOS/OS junk
.DS_Store
