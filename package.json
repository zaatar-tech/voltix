{
  "name": "@zaatar-tech/voltix",
  "version": "2.1.0",
  "description": "Fastest React state library. Per-key subscriptions, 5.0 KB, zero dependencies.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.mjs",
      "require": "./dist/eslint.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaatar-tech/voltix.git"
  },
  "homepage": "https://voltix.zaatar.tech",
  "bugs": {
    "url": "https://github.com/zaatar-tech/voltix/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts src/eslint.ts --format esm,cjs --dts --minify --clean",
    "size": "node scripts/size.mjs",
    "size:write": "node scripts/size.mjs --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON bench/vs.ts",
    "bench:vitest": "vitest bench --run",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "prepare": "npm run build"
  },
  "keywords": [
    "voltix",
    "react",
    "state",
    "state-management",
    "store",
    "fine-grained",
    "selector",
    "hook",
    "tiny",
    "fast",
    "typescript"
  ],
  "author": "Ohad Baehr - Zaatar Tech",
  "license": "MIT",
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@legendapp/state": "^2.1.15",
    "@preact/signals-core": "^1.14.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "jotai": "^2.20.2",
    "jsdom": "^28.1.0",
    "nanostores": "^1.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "solid-js": "^1.9.15",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "valtio": "^2.3.2",
    "vitest": "^4.0.18",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
